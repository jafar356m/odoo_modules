<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_allocation" model="ir.ui.view">
        <field name="name">account.payment.form.allocation</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Manual Allocation"
                          name="manual_allocation_page">
                        <field name="allocation_line_ids" context="{'default_payment_id': active_id}" colspan="4">
                            <tree editable="bottom">
                                <field name="move_id"
                                       domain="[('partner_id', '=', parent.partner_id), ('company_id', '=', parent.company_id), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]"/>
                                <field name="invoice_name" readonly="1"/>
                                <field name="invoice_date" readonly="1"/>
                                <field name="invoice_amount_total" readonly="1"/>
                                <field name="invoice_residual" readonly="1"/>
                                <field name="allocated_amount"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
